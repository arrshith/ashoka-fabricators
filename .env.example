# Public canonical origin. Set before production build.
NEXT_PUBLIC_SITE_URL=http://localhost:5173
# Optional runtime canonical origin (takes precedence on hosted Workers).
SITE_URL=http://localhost:5173
# Runtime values: copy into .dev.vars for local Worker execution.
RATE_LIMIT_SECRET=replace-with-a-random-32-byte-secret
# Optional HTTPS service to forward enquiries to the business.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
